  "contrast": {
    "$description": "Pares que build-tokens.mjs verifica en cada tema. min = razón WCAG mínima. Si alguno falla, el build falla.",
    "pairs": [
      {
        "fg": "text",
        "bg": "bg",
        "min": 4.5
      },
      {
        "fg": "text",
        "bg": "surface",
        "min": 4.5
      },
      {
        "fg": "text-secondary",
        "bg": "surface",
        "min": 4.5
      },
      {
        "fg": "text-secondary",
        "bg": "bg",
        "min": 4.5
      },
      {
        "fg": "text-placeholder",
        "bg": "surface",
        "min": 4.5
      },
      {
        "fg": "text-placeholder",
        "bg": "bg",
        "min": 4.5
      },
      {
        "fg": "link",
        "bg": "surface",
        "min": 4.5
      },
      {
        "fg": "kicker",
        "bg": "bg",
        "min": 4.5
      },
      {
        "fg": "primary-text",
        "bg": "primary",
        "min": 4.5
      },
      {
        "fg": "primary-text",
        "bg": "primary-hover",
        "min": 4.5
      },
      {
        "fg": "sidebar-text",
        "bg": "sidebar-bg",
        "min": 4.5
      },
      {
        "fg": "sidebar-text-muted",
        "bg": "sidebar-bg",
        "min": 4.5
      },
      {
        "fg": "success-text",
        "bg": "success-bg",
        "min": 4.5
      },
      {
        "fg": "success-text",
        "bg": "surface",
        "min": 4.5
      },
      {
        "fg": "warning-text",
        "bg": "warning-bg",
        "min": 4.5
      },
      {
        "fg": "warning-text",
        "bg": "surface",
        "min": 4.5
      },
      {
        "fg": "error-text",
        "bg": "error-bg",
        "min": 4.5
      },
      {
        "fg": "error-text",
        "bg": "surface",
        "min": 4.5
      },
      {
        "fg": "info-text",
        "bg": "info-bg",
        "min": 4.5
      },
      {
        "fg": "success-solid",
        "bg": "surface",
        "min": 3
      },
