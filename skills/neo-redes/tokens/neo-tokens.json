{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Fuente única de la línea gráfica NEO para software. Todo lo demás (CSS, Tailwind, shadcn, gráficos, DESIGN.md) se genera o se valida contra este archivo con scripts/build-tokens.mjs. No editar los derivados a mano.",
  "$extensions": {
    "neo": {
      "version": "1.2.0",
      "sources": [
        "Brandbook NEO Consulting, Sistema Visual v1.0 (2026): escalas Deep Navy y Royal Blue, colores semánticos, Montserrat, iconografía de trazo 2 px.",
        "mcp-presentaciones/design_knowledge/tokens.yaml (neo_historical_v2) y la referencia Credicorp Taller 1 v7, aprobada por diseño NEO el 2026-09-22: azul canónico 2D5BFF, cards, radios, sombra card.",
        "Decisiones de la sesión de diseño del 2026-10-16 (estados afinados a la escala navy, modo oscuro obligatorio, radios en px, movimiento).",
        "Decisión del 2026-11-07 (modo oscuro): el fondo pasa al Deep Navy alterno del Brandbook (#050917, Escala Deep Navy, pág. 6) y las superficies oscuras bajan de croma (escala night) con la misma claridad. El azul de marca queda para acciones, selección y datos."
      ],
      "legacy": {
        "#2B5BFC": "Azul del Brandbook v1.0 y de neo-landing. Superado por #2D5BFF; se migra (aviso, no error)."
      }
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "deep-navy": {
        "$value": "#000033",
        "$description": "Primario dominante. Texto principal en claro, barra lateral y superficies de marca."
      },
      "royal-blue": {
        "$value": "#2D5BFF",
        "$description": "Azul canónico NEO. Acción principal, enlaces, kicker, énfasis y foco."
      },
      "blue-soft": {
        "$value": "#7E99FE",
        "$description": "Azul suave. Solo sobre fondos oscuros como texto, o como relleno decorativo; nunca texto sobre blanco (2.67:1)."
      },
      "blue-pale": {
        "$value": "#C5D5F7",
        "$description": "Azul pálido. Fondos de selección, celdas negativas de tablas comparativas y bordes de tabla comparativa."
      },
      "periwinkle": {
        "$value": "#9AAFFE",
        "$description": "Énfasis del modo oscuro (separator_blue). Enlaces y títulos resaltados sobre navy (9.5:1)."
      },
      "white": {
        "$value": "#FFFFFF"
      }
    },
    "navy": {
      "$description": "Escala Deep Navy del Brandbook. Son los únicos neutros permitidos: grises con tinte navy. Prohibidos los grises puros.",
      "50": {
        "$value": "#F2F4F8",
        "$description": "Navy Ice. Fondo de página en claro, encabezado de tabla operativa."
      },
      "100": {
        "$value": "#E1E6EE",
        "$description": "Glacial Tint. Bordes por defecto, divisores."
      },
      "200": {
        "$value": "#BAC7D9",
        "$description": "Soft Steel. Bordes fuertes; texto secundario en oscuro."
      },
      "300": {
        "$value": "#8DA3C0",
        "$description": "Slate Mist. Texto deshabilitado; placeholder en oscuro."
      },
      "400": {
        "$value": "#5E7CA1",
        "$description": "Classic Steel. Íconos secundarios; texto solo a 18 px o más (4.31:1)."
      },
      "450": {
        "$value": "#527198",
        "$description": "Derivado NEO (no está en el Brandbook): placeholder en claro, 5.0:1 sobre blanco."
      },
      "500": {
        "$value": "#395882",
        "$description": "Corporate Blue. Texto secundario en claro (7.26:1)."
      },
      "600": {
        "$value": "#223C63",
        "$description": "Admiral Navy. Bordes en oscuro."
      },
      "700": {
        "$value": "#132647",
        "$description": "Abyss Blue. Superficie elevada en oscuro."
      },
      "800": {
        "$value": "#000033",
        "$description": "Deep Navy."
      },
      "900": {
        "$value": "#1A1A2E",
        "$description": "Dark Charcoal. Solo para el degradado Night Tech."
      }
    },
    "night": {
      "$description": "Escala night (derivada NEO): neutros del modo oscuro con el tinte del Deep Navy y croma bajo, para que el azul de marca sea acento y no el fondo. Misma claridad que las superficies navy anteriores, así que los contrastes se mantienen.",
      "ground": {
        "$value": "#050917",
        "$description": "Fondo del modo oscuro. Deep Navy alterno del Brandbook (Escala Deep Navy, pág. 6: «Deep Navy #000033 / #050917»)."
      },
      "sunken": {
        "$value": "#080D1B",
        "$description": "Barra lateral, encabezado de tabla y superficies hundidas en oscuro."
      },
      "surface": {
        "$value": "#101524",
        "$description": "Cards y paneles en oscuro."
      },
      "raised": {
        "$value": "#191F2F",
        "$description": "Superficies elevadas y skeletons en oscuro."
      },
      "hover": {
        "$value": "#202637",
        "$description": "Hover en oscuro; borde de la barra lateral."
      },
      "selected": {
        "$value": "#12244D",
        "$description": "Seleccionado, primary-soft e información en oscuro: lo único con azul de marca en las superficies."
      },
      "line": {
        "$value": "#343C4F",
        "$description": "Bordes, divisores, selección de texto y grilla de gráficos en oscuro."
      },
      "line-strong": {
        "$value": "#5C657A",
        "$description": "Bordes fuertes y contornos de controles en oscuro (3.1:1 sobre la card)."
      },
      "text-muted": {
        "$value": "#C1C6D2",
        "$description": "Texto e íconos secundarios en oscuro."
      },
      "placeholder": {
        "$value": "#9AA1B2",
        "$description": "Placeholder en oscuro (7.0:1 sobre la card)."
      }
    },
    "blue": {
      "$description": "Escala de acción construida sobre el azul canónico, con pasos del Brandbook y de presentaciones.",
      "50": {
        "$value": "#EEF2FF",
        "$description": "Royal Mist. Fondo de información y de fila seleccionada."
      },
      "100": {
        "$value": "#E0E7FF",
        "$description": "Electric Hint. Hover de elementos seleccionados."
      },
      "200": {
        "$value": "#C5D5F7",
        "$description": "Pale Blue."
      },
      "300": {
        "$value": "#9AAFFE",
        "$description": "Periwinkle."
      },
      "400": {
        "$value": "#7E99FE",
        "$description": "Blue soft."
      },
      "500": {
        "$value": "#2D5BFF",
        "$description": "Royal Blue canónico."
      },
      "600": {
        "$value": "#234BE9",
        "$description": "Hover del primario (6.45:1 con texto blanco)."
      },
      "700": {
        "$value": "#1E3ECC",
        "$description": "Pressed del primario; texto de información."
      },
      "800": {
        "$value": "#172A91",
        "$description": "Deep Royal."
      },
      "900": {
        "$value": "#101C5C",
        "$description": "Imperial Dark."
      }
    },
    "success": {
      "$description": "Verde afinado a la escala navy (mismas luminosidades OKLCH). 500 = indicador (≥3:1), 700 = texto (6.8:1), 50 = fondo suave.",
      "50": {
        "$value": "#E9F9EC"
      },
      "100": {
        "$value": "#CFEFD6"
      },
      "200": {
        "$value": "#9CD6AB"
      },
      "300": {
        "$value": "#5FB77A"
      },
      "400": {
        "$value": "#37A45F"
      },
      "500": {
        "$value": "#009249"
      },
      "600": {
        "$value": "#057E3F"
      },
      "700": {
        "$value": "#046933"
      },
      "800": {
        "$value": "#024922"
      },
      "900": {
        "$value": "#003014"
      }
    },
    "warning": {
      "$description": "Ámbar afinado a la escala navy. 500 = indicador, 700 = texto (7.45:1), 50 = fondo suave.",
      "50": {
        "$value": "#FFF2E3"
      },
      "100": {
        "$value": "#FAE1C4"
      },
      "200": {
        "$value": "#E9BD88"
      },
      "300": {
        "$value": "#D0933F"
      },
      "400": {
        "$value": "#BE7C02"
      },
      "500": {
        "$value": "#A56C06"
      },
      "600": {
        "$value": "#905C00"
      },
      "700": {
        "$value": "#774C03"
      },
      "800": {
        "$value": "#543400"
      },
      "900": {
        "$value": "#382101"
      }
    },
    "error": {
      "$description": "Rojo afinado a la escala navy. 500 = indicador, 700 = texto (7.87:1), 50 = fondo suave. También es el color destructivo.",
      "50": {
        "$value": "#FEF1EF"
      },
      "100": {
        "$value": "#FFDCD9"
      },
      "200": {
        "$value": "#FDAEA7"
      },
      "300": {
        "$value": "#EA7C75"
