      "info-solid": "{color.blue.400}",
      "info-text": "{color.blue.300}",
      "skeleton": "{color.night.raised}",
      "skeleton-highlight": "{color.night.hover}",
      "scrim": "rgba(0, 0, 0, 0.6)",
