  "theme": {
    "$description": "Roles semánticos. Los componentes usan SOLO estos roles (var(--neo-<rol>)), nunca la escala directa, para que el modo oscuro funcione sin tocar el componente. En oscuro, los fondos de estado son el color del estado al 16 % sobre la superficie navy (y al 38 % para el borde): calmos, no rojo o verde saturado.",
    "light": {
      "bg": "{color.navy.50}",
      "surface": "{color.brand.white}",
      "surface-raised": "{color.brand.white}",
      "surface-sunken": "{color.navy.50}",
      "surface-hover": "{color.blue.50}",
      "surface-selected": "{color.blue.50}",
      "border": "{color.navy.100}",
      "border-strong": "{color.navy.200}",
      "text": "{color.brand.deep-navy}",
      "text-secondary": "{color.navy.500}",
      "text-placeholder": "{color.navy.450}",
      "text-disabled": "{color.navy.300}",
      "text-inverse": "{color.brand.white}",
      "title": "{color.brand.deep-navy}",
      "kicker": "{color.brand.royal-blue}",
      "emphasis": "{color.brand.royal-blue}",
      "link": "{color.brand.royal-blue}",
      "link-hover": "{color.blue.700}",
      "icon": "{color.brand.deep-navy}",
      "icon-secondary": "{color.navy.400}",
      "primary": "{color.blue.500}",
      "primary-hover": "{color.blue.600}",
      "primary-pressed": "{color.blue.700}",
      "primary-text": "{color.brand.white}",
      "primary-soft": "{color.blue.50}",
      "focus": "{color.blue.500}",
      "accent-bar": "{color.blue.500}",
      "selection": "{color.blue.200}",
      "sidebar-bg": "{color.brand.deep-navy}",
      "sidebar-border": "{color.brand.deep-navy}",
      "sidebar-text": "{color.brand.white}",
      "sidebar-text-muted": "{color.navy.200}",
      "sidebar-icon": "{color.blue.300}",
      "sidebar-hover": "rgba(126, 153, 254, 0.12)",
      "sidebar-active": "rgba(126, 153, 254, 0.20)",
      "sidebar-indicator": "{color.blue.500}",
      "success-bg": "{color.success.50}",
      "success-border": "{color.success.200}",
      "success-solid": "{color.success.500}",
      "success-text": "{color.success.700}",
      "warning-bg": "{color.warning.50}",
      "warning-border": "{color.warning.200}",
      "warning-solid": "{color.warning.500}",
      "warning-text": "{color.warning.700}",
      "error-bg": "{color.error.50}",
      "error-border": "{color.error.200}",
      "error-solid": "{color.error.500}",
      "error-text": "{color.error.700}",
      "info-bg": "{color.blue.50}",
      "info-border": "{color.blue.200}",
      "info-solid": "{color.blue.500}",
      "info-text": "{color.blue.700}",
      "skeleton": "{color.navy.50}",
      "skeleton-highlight": "{color.navy.100}",
      "scrim": "rgba(0, 0, 51, 0.48)",
      "table-head-bg": "{color.navy.50}",
      "compare-head-bg": "{color.brand.deep-navy}",
      "compare-border": "{color.blue.200}",
      "compare-highlight": "{color.blue.500}",
      "compare-negative": "{color.blue.200}"
    },
    "dark": {
      "bg": "{color.night.ground}",
      "surface": "{color.night.surface}",
      "surface-raised": "{color.night.raised}",
      "surface-sunken": "{color.night.sunken}",
      "surface-hover": "{color.night.hover}",
      "surface-selected": "{color.night.selected}",
      "border": "{color.night.line}",
      "border-strong": "{color.night.line-strong}",
      "text": "{color.brand.white}",
      "text-secondary": "{color.night.text-muted}",
      "text-placeholder": "{color.night.placeholder}",
      "text-disabled": "{color.night.line-strong}",
      "text-inverse": "{color.brand.deep-navy}",
      "title": "{color.brand.white}",
      "kicker": "{color.blue.300}",
      "emphasis": "{color.blue.300}",
      "link": "{color.blue.300}",
      "link-hover": "{color.blue.200}",
      "icon": "{color.brand.white}",
      "icon-secondary": "{color.night.text-muted}",
      "primary": "{color.blue.500}",
      "primary-hover": "{color.blue.600}",
      "primary-pressed": "{color.blue.700}",
      "primary-text": "{color.brand.white}",
      "primary-soft": "{color.night.selected}",
      "focus": "{color.blue.300}",
      "accent-bar": "{color.blue.500}",
      "selection": "{color.night.line}",
      "sidebar-bg": "{color.night.sunken}",
      "sidebar-border": "{color.night.hover}",
      "sidebar-text": "{color.brand.white}",
      "sidebar-text-muted": "{color.night.text-muted}",
