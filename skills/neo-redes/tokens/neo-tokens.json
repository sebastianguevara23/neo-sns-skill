  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Montserrat",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "Tipografía institucional única."
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ],
        "$description": "Solo para código, IDs técnicos y valores que deban alinearse por carácter."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "extrabold": {
        "$value": 800
      },
      "black": {
        "$value": 900
      }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Escala de aplicaciones (no la de piezas de 1920 px del Brandbook). Mínimo absoluto 12 px.",
    "kicker": {
      "$value": {
        "fontSize": "12px",
        "fontWeight": 600,
        "lineHeight": 1.33,
        "letterSpacing": "0.08em",
        "textTransform": "uppercase"
      },
      "$description": "Contexto de navegación sobre el título (módulo · periodo). Nunca un eslogan."
    },
    "page-title": {
